# Umgebungsvariablen für den Betrieb in Coolify (docker-compose.coolify.yml).
#
# In Coolify werden Variablen nicht aus dieser Datei gelesen, sondern in der
# Oberfläche der Ressource gepflegt (Environment Variables). Diese Datei ist
# die Vorlage zum Hineinkopieren und erklärt, was Coolify selbst erzeugt.
#
# Domains (Reiter „Domains" je Service, Wildcard *.tjl-it.de ist am Server hinterlegt):
#   frontend  → https://mail.tjl-it.de
#   mcp       → https://mcp.tjl-it.de   (nur wenn MCP über HTTP genutzt wird)
#
# Von Coolify automatisch erzeugt (nicht eintragen, nur zum Verständnis):
#   SERVICE_FQDN_FRONTEND        mail.tjl-it.de            → MAIL_ALLOWED_HOSTS
#   SERVICE_URL_FRONTEND         https://mail.tjl-it.de    → MAIL_PUBLIC_URL
#   SERVICE_FQDN_MCP             mcp.tjl-it.de             → MCP_ALLOWED_HOSTS
#   SERVICE_HEX_64_CRYPTO        64 Hex-Zeichen            → MAIL_CRYPTO_KEY
#   SERVICE_PASSWORD_SETUP       Einrichtungs-Schlüssel    → MAIL_SETUP_TOKEN
#   SERVICE_PASSWORD_64_APIKEY   Schlüssel für /api/v1     → MAIL_API_KEY
#   SERVICE_PASSWORD_64_MCPTOKEN Bearer-Token für MCP      → MCP_TOKEN
# Die Werte stehen nach dem ersten Speichern in der Coolify-Oberfläche und
# bleiben über Deploys hinweg gleich. MAIL_CRYPTO_KEY nie ändern, sonst sind
# die gespeicherten SMTP-Passwörter nicht mehr lesbar. Sichere den Wert extern.

# ---- Optional: Verhalten ---------------------------------------------------
# Sitzungsdauer (Stunden) bzw. mit „Angemeldet bleiben" (Tage)
MAIL_SESSION_HOURS=12
MAIL_SESSION_REMEMBER_DAYS=30
# Anfragen pro Minute für die Versand-API
MAIL_API_RATE_LIMIT=60

# CardDAV-/GitHub-Ziele im privaten Netz oder per http zulassen (Standard: aus)
MAIL_ALLOW_PRIVATE_HOSTS=0
# IMAP ohne Zertifikatsprüfung (Standard: Prüfung an)
MAIL_IMAP_ALLOW_SELF_SIGNED=0

# WhatsApp-Konten beim Start automatisch verbinden
WA_AUTOSTART=1
# Darf der MCP-Server WhatsApp-Nachrichten senden? (zusätzlich pro Konto in der UI)
MAIL_WA_MCP_SEND=0

# ---- Optional: MCP über HTTP ----------------------------------------------
# Erlaubte Origin-Header (Browser-Clients). Desktop-Clients schicken keinen Origin.
MCP_ALLOWED_ORIGINS=https://claude.ai
# Nur lesende Werkzeuge anbieten
MCP_READONLY=0
MCP_RATE_LIMIT=120
