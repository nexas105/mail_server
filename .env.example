# Vorlage für den Server-Betrieb. Kopieren nach .env (wird nicht committet) und
# beim Start laden, z.B.  `set -a; source .env; set +a; npm start`
# oder als Environment= in der systemd-Unit.

# ---- Web-Server -----------------------------------------------------------
PORT=3000
# 127.0.0.1 = nur lokal (Standard). Für den Serverbetrieb hinter einem
# Reverse-Proxy ebenfalls 127.0.0.1 lassen; 0.0.0.0 nur, wenn wirklich nötig.
BIND_HOST=127.0.0.1

# Fester Verschlüsselungs-Schlüssel für SMTP-Passwörter & Token (64 Hex-Zeichen).
# Ohne diesen Wert erzeugt der Server data/.keyfile selbst.
#   openssl rand -hex 32
# MAIL_CRYPTO_KEY=

# ---- Anmeldung ------------------------------------------------------------
# Solange kein Konto existiert, zeigt die Web-UI die Ersteinrichtung. Ist der
# Server dabei aus dem Netz erreichbar, diesen Schlüssel setzen – dann kann nur
# jemand mit dem Wert den ersten Administrator anlegen.
# MAIL_SETUP_TOKEN=

# Sitzungsdauer (Stunden) bzw. mit „Angemeldet bleiben" (Tage)
# MAIL_SESSION_HOURS=12
# MAIL_SESSION_REMEMBER_DAYS=30
# Sperre nach zu vielen Fehlversuchen
# MAIL_LOGIN_MAX_ATTEMPTS=8
# MAIL_LOGIN_LOCK_MINUTES=15

# ---- Reverse-Proxy / TLS --------------------------------------------------
# Anzahl vertrauenswürdiger Proxy-Hops (oder 1 / IP-Liste). Erst damit stimmen
# Client-IP für Rate-Limits und die https-Erkennung fürs Session-Cookie.
# MAIL_TRUST_PROXY=1
# Erlaubte Host-Header (Komma-getrennt) – Schutz gegen DNS-Rebinding.
# MAIL_ALLOWED_HOSTS=mail.example.de
# Zusätzliche interne Namen, die immer gelten (Docker setzt das selbst).
# MAIL_INTERNAL_HOSTS=backend,127.0.0.1
# Session-Cookie immer/nie mit Secure-Flag (Standard: automatisch)
# MAIL_COOKIE_SECURE=1

# ---- Ausgehende Verbindungen ---------------------------------------------
# CardDAV- und GitHub-Adressen müssen https sein und dürfen nicht auf interne
# Ziele zeigen (localhost, 10/8, 192.168/16, 169.254/16 …). Für Heimnetz-Setups:
# MAIL_ALLOW_PRIVATE_HOSTS=1
# IMAP-Zertifikate werden geprüft. Selbstsignierte Zertifikate zulassen:
# MAIL_IMAP_ALLOW_SELF_SIGNED=1

# ---- Zustell-Nachverfolgung ----------------------------------------------
# Adresse, unter der EMPFÄNGER diesen Server erreichen. Ohne sie wird kein
# Zählpixel eingebaut (ein Pixel auf localhost misst nichts).
# MAIL_PUBLIC_URL=https://mail.example.de
# Öffnungen messen ist zusätzlich in der UI zu aktivieren (Einstellungen →
# Zustellung nachverfolgen) – standardmäßig aus, weil personenbezogen.
# Bounces werden immer erkannt, sobald IMAP am Konto eingerichtet ist.

# ---- Externe Versand-API (/api/v1) ---------------------------------------
# MAIL_API_KEY=
# MAIL_API_RATE_LIMIT=60

# ---- MCP-Server im HTTP-Betrieb ------------------------------------------
# MCP_TRANSPORT=http
# MCP_PORT=3010
# MCP_BIND_HOST=127.0.0.1
# Pflicht im HTTP-Betrieb:  openssl rand -hex 32
# MCP_TOKEN=
# Token gibt es auch verwaltet in der Oberfläche (Einstellungen → MCP-Zugriff):
# benannt, einzeln widerrufbar, optional nur-lesend. MCP_TOKEN ist der einfache
# Fall für genau einen Client; beides gilt gleichzeitig.
# Obergrenze für das MCP-Protokoll (Anzahl Einträge)
# MCP_LOG_CAP=5000
# Erlaubte Host-/Origin-Header (Komma-getrennt)
# MCP_ALLOWED_HOSTS=mcp.example.de
# MCP_ALLOWED_ORIGINS=https://claude.ai
# Nur lesende Werkzeuge anbieten
# MCP_READONLY=1
# Einzelne Werkzeuge abschalten bzw. ausschließlich diese anbieten
# MCP_DISABLED_TOOLS=send_draft,delete_smtp_account
# MCP_ENABLED_TOOLS=
# Ordner, aus dem Anhänge per Pfad gelesen werden dürfen (sonst nur base64)
# MCP_FILES_DIR=/srv/mail-server/uploads
# MCP_MAX_SESSIONS=32
# MCP_SESSION_IDLE_MINUTES=30
# MCP_RATE_LIMIT=120
# MCP_TRUST_PROXY=1

# ---- WhatsApp -------------------------------------------------------------
# MAIL_WA_MCP_SEND=1
# WA_AUTOSTART=0

# ---- Docker Compose -------------------------------------------------------
# Port/Adresse, auf der nginx (Frontend + /api-Proxy) am Host lauscht. Davor
# gehört ein TLS-Reverse-Proxy; darum standardmäßig nur 127.0.0.1.
WEB_PORT=8080
WEB_BIND=127.0.0.1
# Host-Adresse des optionalen MCP-Dienstes (docker compose --profile mcp)
MCP_BIND=127.0.0.1
# BIND_HOST, MAIL_TRUST_PROXY und MAIL_DATA_DIR setzt docker-compose.yml selbst –
# die Werte oben gelten nur für den Betrieb ohne Docker.
# Im Docker-Betrieb unbedingt setzen: MAIL_CRYPTO_KEY (sonst liegt der Schlüssel
# nur im Volume) und MAIL_ALLOWED_HOSTS auf den öffentlichen Hostnamen.

# Sprachnachrichten in Text (WhatsApp). OpenAI-kompatibler Dienst; leer = aus.
# Lokal: docker compose --profile whisper up -d  →  http://whisper:8000/v1
# OpenAI: https://api.openai.com/v1 mit MAIL_TRANSCRIBE_KEY und MAIL_TRANSCRIBE_MODEL=whisper-1
# MAIL_TRANSCRIBE_URL=http://whisper:8000/v1
# MAIL_TRANSCRIBE_KEY=
# MAIL_TRANSCRIBE_MODEL=Systran/faster-whisper-small
# MAIL_TRANSCRIBE_LANG=de
